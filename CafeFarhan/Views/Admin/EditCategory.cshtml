@model CafeFarhan.Models.Category

@{
    ViewData["Title"] = "ویرایش دسته‌بندی";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <style>

            body {
                font-family: Tahoma, Arial, sans-serif;
                background: #f5f5f5;
                margin: 0;
                padding: 0;
            }

            .container {
                max-width: 600px;
                margin: auto;
            }

            .card {
                background: white;
                padding: 30px;
                border-radius: 15px;
                box-shadow: 0 3px 20px rgba(0,0,0,.08);
            }

            h1 {
                margin-top: 0;
                margin-bottom: 25px;
            }

            .form-group {
                margin-bottom: 20px;
            }

            label {
                display: block;
                margin-bottom: 8px;
                font-weight: bold;
            }

            input {
                width: 100%;
                box-sizing: border-box;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 8px;
                font-family: inherit;
                font-size: 15px;
            }

                input:focus {
                    outline: none;
                    border-color: #0d6efd;
                }

            .buttons {
                display: flex;
                gap: 10px;
                margin-top: 30px;
            }

            .btn {
                border: none;
                padding: 12px 25px;
                border-radius: 8px;
                cursor: pointer;
                font-family: inherit;
                font-size: 15px;
                text-decoration: none;
            }

            .save-btn {
                background: #198754;
                color: white;
            }

                .save-btn:hover {
                    background: #157347;
                }

            .back-btn {
                background: #6c757d;
                color: white;
            }

            .validation {
                color: #dc3545;
                margin-bottom: 15px;
            }

    </style>

</head>

<body>

    <div class="container">

        <div class="card">

            <h1>
                ویرایش دسته‌بندی
            </h1>

            <form method="post"
                  action="/Admin/EditCategory/@Model.Id">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <div asp-validation-summary="All"
                     class="validation">
                </div>


                <div class="form-group">

                    <label asp-for="Name">
                        نام دسته‌بندی
                    </label>

                    <input asp-for="Name" />

                </div>


                <div class="form-group">

                    <label asp-for="DisplayOrder">
                        ترتیب نمایش
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           min="1" />

                </div>


                <div class="buttons">

                    <button type="submit"
                            class="btn save-btn">
                        ذخیره تغییرات
                    </button>

                    <a href="/Admin/Categories"
                       class="btn back-btn">
                        بازگشت
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>

</html>
