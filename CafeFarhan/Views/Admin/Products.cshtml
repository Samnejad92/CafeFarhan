@model IEnumerable<CafeFarhan.Models.Product>

@{
    ViewData["Title"] = "مدیریت محصولات";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />

    <style>
            body {
                font-family: Tahoma, Arial, sans-serif;
                background: #f5f5f5;
                margin: 0;
                padding: 0;
            }

            .container {
                max-width: 1200px;
                margin: auto;
            }

            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }

            h1 {
                margin: 0;
            }

            .add-btn {
                background: #198754;
                color: white;
                text-decoration: none;
                padding: 12px 20px;
                border-radius: 8px;
            }

                .add-btn:hover {
                    background: #157347;
                }

            .products-table {
                width: 100%;
                background: white;
                border-collapse: collapse;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 3px 15px rgba(0,0,0,.08);
            }

                .products-table th,
                .products-table td {
                    padding: 14px;
                    border-bottom: 1px solid #eee;
                    text-align: right;
                }

                .products-table th {
                    background: #222;
                    color: white;
                }

                .products-table tr:hover {
                    background: #fafafa;
                }

            .price {
                font-weight: bold;
                color: #198754;
            }

            .available {
                color: #198754;
                font-weight: bold;
            }

            .unavailable {
                color: #dc3545;
                font-weight: bold;
            }

            .edit-btn {
                display: inline-block;
                background: #0d6efd;
                color: white;
                text-decoration: none;
                padding: 8px 16px;
                border-radius: 7px;
            }

                .edit-btn:hover {
                    background: #0b5ed7;
                }
    </style>
</head>

<body>

    <div class="container">
        <div class="header">

        <h1>مدیریت محصولات</h1>

        <a href="/Admin/AddProduct"
           class="add-btn">
            + افزودن محصول
        </a>
        </div>

        <table class="products-table">

            <thead>
                <tr>
                    <th>نام محصول</th>
                    <th>دسته‌بندی</th>
                    <th>قیمت</th>
                    <th>مواد اولیه</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var product in Model)
                {
                    <tr>

                        <td>
                            @product.Name
                        </td>

                        <td>
                            @product.Category?.Name
                        </td>

                        <td class="price">
                            @product.Price.ToString("N0")
                            تومان
                        </td>

                        <td>
                            @product.Ingredients
                        </td>

                        <td>
                            @if (product.IsAvailable)
                            {
                                <span class="available">موجود</span>
                            }
                            else
                            {
                                <span class="unavailable">ناموجود</span>
                            }
                        </td>

                        <td>
                            <a class="edit-btn"
                               href="/Admin/EditProduct/@product.Id">
                                ویرایش
                            </a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</body>
</html>
