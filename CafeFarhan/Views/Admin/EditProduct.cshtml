@model CafeFarhan.Models.Product

@{
    ViewData["Title"] = "ویرایش محصول";

    var categories =
        ViewBag.Categories as List<CafeFarhan.Models.Category>;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <style>

            body {
                font-family: Tahoma, Arial, sans-serif;
                background: #f5f5f5;
                margin: 0;
                padding: 0;
            }

            .container {
                max-width: 700px;
                margin: auto;
            }

            .card {
                background: white;
                padding: 30px;
                border-radius: 15px;
                box-shadow: 0 3px 20px rgba(0,0,0,.08);
            }

            h1 {
                margin-top: 0;
                margin-bottom: 25px;
            }

            .form-group {
                margin-bottom: 20px;
            }

            label {
                display: block;
                margin-bottom: 8px;
                font-weight: bold;
            }

            input,
            textarea,
            select {
                width: 100%;
                box-sizing: border-box;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 8px;
                font-family: inherit;
                font-size: 15px;
            }

            textarea {
                min-height: 100px;
                resize: vertical;
            }

                input:focus,
                textarea:focus,
                select:focus {
                    outline: none;
                    border-color: #0d6efd;
                }

            .checkbox-container {
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .checkbox-container input {
                    width: auto;
                }

            .buttons {
                display: flex;
                gap: 10px;
                margin-top: 30px;
            }

            .btn {
                border: none;
                padding: 12px 25px;
                border-radius: 8px;
                cursor: pointer;
                font-family: inherit;
                font-size: 15px;
                text-decoration: none;
            }

            .btn-save {
                background: #198754;
                color: white;
            }

                .btn-save:hover {
                    background: #157347;
                }

            .btn-back {
                background: #6c757d;
                color: white;
            }

            .validation {
                color: #dc3545;
                margin-bottom: 15px;
            }

    </style>

</head>

<body>

    <div class="container">

        <div class="card">

            <h1>ویرایش محصول</h1>

            <form method="post"
                  action="/Admin/EditProduct/@Model.Id">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="validation">
                </div>

                <div class="form-group">

                    <label asp-for="Name">
                        نام محصول
                    </label>

                    <input asp-for="Name" />

                </div>


                <div class="form-group">

                    <label asp-for="Price">
                        قیمت
                    </label>

                    <input asp-for="Price"
                           type="number"
                           min="0"
                           step="1000" />

                </div>


                <div class="form-group">

                    <label asp-for="CategoryId">
                        دسته‌بندی
                    </label>

                    <select asp-for="CategoryId">

                        @foreach (var category in categories!)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label asp-for="Description">
                        توضیحات
                    </label>

                    <textarea asp-for="Description"></textarea>

                </div>


                <div class="form-group">

                    <label asp-for="Ingredients">
                        مواد اولیه
                    </label>

                    <textarea asp-for="Ingredients"></textarea>

                </div>


                <div class="form-group">

                    <label asp-for="ImageUrl">
                        آدرس تصویر
                    </label>

                    <input asp-for="ImageUrl"
                           placeholder="/images/products/example.jpg" />

                </div>


                <div class="form-group">

                    <div class="checkbox-container">

                        <input asp-for="IsAvailable"
                               type="checkbox" />

                        <label asp-for="IsAvailable">
                            محصول موجود است
                        </label>

                    </div>

                </div>


                <div class="buttons">

                    <button type="submit"
                            class="btn btn-save">
                        ذخیره تغییرات
                    </button>

                    <a href="/Admin/Products"
                       class="btn btn-back">
                        بازگشت
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>
</html>
