@model CafeFarhan.Models.Order
@using System.Globalization

@{
    Layout = null;

    var persianCalendar = new PersianCalendar();

    var year = persianCalendar.GetYear(Model.CreatedAt);
    var month = persianCalendar.GetMonth(Model.CreatedAt);
    var day = persianCalendar.GetDayOfMonth(Model.CreatedAt);

    var persianDate =
        $"{year:0000}/{month:00}/{day:00}";

    var time =
        Model.CreatedAt.ToString("HH:mm");
}


<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />

    <title>سفارش #@Model.Id</title>

    <style>
            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                width: 80mm;
                background: #fff;
            }

            body {
                font-family: Tahoma, Arial, sans-serif;
                color: #000;
                font-size: 11px;
            }

            .receipt {
                width: 80mm;
                padding: 2mm 3mm;
            }

            .center {
                text-align: center;
            }

            h1 {
                font-size: 16px;
                margin: 0 0 2px 0;
            }

            .header-info {
                line-height: 1.4;
            }

            .line {
                border-top: 1px dashed #000;
                margin: 4px 0;
                height: 0;
            }

            .item {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                width: 100%;
                margin: 3px 0;
                font-size: 11px;
                line-height: 1.3;
                direction: rtl;
            }

            .item-name {
                flex: 1;
                text-align: right;
                padding-left: 4px;
            }

            .item-price {
                white-space: nowrap;
                text-align: left;
            }

            .total {
                display: flex;
                justify-content: space-between;
                align-items: center;
                width: 100%;
                font-weight: bold;
                font-size: 13px;
                line-height: 1.4;
            }

            small {
                font-size: 9px;
            }

            .print-button {
                display: block;
                margin: 10px auto;
                padding: 6px 20px;
                font-size: 14px;
                cursor: pointer;
            }

            @@media print {

                html,
                body {
                    width: 70mm;
                    margin: 0;
                    padding: 0;
                }

                .receipt {
                    width: 70mm;
                    padding: 2mm 3mm;
                }

                .print-button {
                    display: none !important;
                }

                @@page {
                    size: 80mm auto;
                    margin: 0;
                }
            }
    </style>
</head>

<body>

    <div class="receipt">

        <div class="center">
            <h1>کافه فرهان</h1>
            <div class="header-info">

                سفارش #@Model.Id
                <br />

                میز @Model.TableNumber
                <br />

                تاریخ: @persianDate
                <br />

                ساعت: @time

            </div>

        </div>

        <div class="line"></div>

        @foreach (var item in Model.Items)
        {
            <div class="item">
                <div class="item-name">
                    @item.ProductName × @item.Quantity
                </div>

                <div class="item-price">
                    @((item.UnitPrice * item.Quantity).ToString("N0"))
                </div>
            </div>
        }

        <div class="line"></div>

        <div class="total">
            <span>مبلغ کل</span>

            <span>
                @Model.TotalPrice.ToString("N0") تومان
            </span>
        </div>

        <div class="line"></div>

        <div class="center">
            <small>
                با تشکر از انتخاب کافه فرهان ☕
            </small>
        </div>

    </div>

    <button class="print-button" type="button" onclick="window.print()">
        چاپ
    </button>

    <script>
            window.addEventListener("load", function () {
                setTimeout(function () {
                    window.print();
                }, 300);
            });

            window.addEventListener("afterprint", function () {
                // اگر می‌خواهید بعد از چاپ پنجره بسته شود:
                window.close();
            });
    </script>

</body>
</html>