@model CafeFarhan.Models.Order
@{
    Layout = null;
}
<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8">

    <title>
        سفارش #@Model.Id
    </title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                font-family: Tahoma, Arial;
                width: 80mm;
                margin: auto;
                padding: 10px;
                color: #000;
            }

            .center {
                text-align: center;
            }

            h1 {
                font-size: 20px;
                margin-bottom: 5px;
            }

            .line {
                border-top: 1px dashed #000;
                margin: 10px 0;
            }

            .item {
                display: flex;
                justify-content: space-between;
                margin: 8px 0;
                font-size: 13px;
            }

            .total {
                display: flex;
                justify-content: space-between;
                font-weight: bold;
                font-size: 15px;
            }

            @@media print {

                body {
                    width: 80mm;
                    margin: 0;
                }

            }

            @@page {
    size: 80mm auto;
    margin: 0;
}

body {
    width: 80mm;
    margin: 0;
    padding: 5mm;
}

    </style>

</head>

<body>

    <div class="center">

        <h1>
            کافه فرهان
        </h1>

        <div>
            سفارش #@Model.Id
        </div>

        <div>
            میز @Model.TableNumber
        </div>

    </div>


    <div class="line"></div>


    @foreach (var item in Model.Items)
    {
        <div class="item">

            <span>
                @item.ProductName
                × @item.Quantity
            </span>

            <span>
                @((item.UnitPrice * item.Quantity)
                    .ToString("N0"))
            </span>

        </div>
    }


    <div class="line"></div>


    <div class="total">

        <span>
            مبلغ کل
        </span>

        <span>
            @Model.TotalPrice.ToString("N0")
            تومان
        </span>

    </div>


    <div class="line"></div>


    <div class="center">

        <small>
            با تشکر از انتخاب کافه فرهان ☕
        </small>

    </div>


    <script>

            window.onload = function () {

                window.print();

            };

    </script>

</body>

</html>