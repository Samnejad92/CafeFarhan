@model IEnumerable<CafeFarhan.Models.Category>

@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <style>

            body {
                font-family: Tahoma, Arial, sans-serif;
                background: #f5f5f5;
                margin: 0;
                padding: 0;
            }

            .container {
                max-width: 900px;
                margin: auto;
            }

            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }

            h1 {
                margin: 0;
            }

            .add-btn {
                background: #198754;
                color: white;
                text-decoration: none;
                padding: 12px 20px;
                border-radius: 8px;
            }

                .add-btn:hover {
                    background: #157347;
                }

            table {
                width: 100%;
                background: white;
                border-collapse: collapse;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 3px 15px rgba(0,0,0,.08);
            }

            th,
            td {
                padding: 15px;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

            th {
                background: #222;
                color: white;
            }

            tr:hover {
                background: #fafafa;
            }

            .edit-btn {
                background: #0d6efd;
                color: white;
                text-decoration: none;
                padding: 8px 16px;
                border-radius: 7px;
            }

                .edit-btn:hover {
                    background: #0b5ed7;
                }

            .product-count {
                color: #666;
            }

    </style>

</head>

<body>

    <div class="container">

        <div class="header">

            <h1>
                مدیریت دسته‌بندی‌ها
            </h1>

            <a href="/Admin/AddCategory"
               class="add-btn">
                + افزودن دسته‌بندی
            </a>

        </div>


        <table>

            <thead>

                <tr>
                    <th>نام دسته‌بندی</th>
                    <th>ترتیب نمایش</th>
                    <th>تعداد محصولات</th>
                    <th>عملیات</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var category in Model)
                {
                    <tr>

                        <td>
                            @category.Name
                        </td>

                        <td>
                            @category.DisplayOrder
                        </td>

                        <td class="product-count">
                            @(category.Products?.Count ?? 0)
                            محصول
                        </td>

                        <td>

                            <a href="/Admin/EditCategory/@category.Id"
                               class="edit-btn">
                                ویرایش
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</body>

</html>
